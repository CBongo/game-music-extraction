{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CBongo/game-music-extraction/schemas/instrument-reviewed-corpus-plan-v1.schema.json",
  "title": "Hash-bound reviewed native corpus build plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases",
    "policy",
    "index"
  ],
  "properties": {
    "schema_version": {
      "const": "instrument-reviewed-corpus-plan/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "record_id",
          "split",
          "source_kind",
          "game_id",
          "origin_family_id",
          "native_manifest",
          "pitch_calibration",
          "sample"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "development",
              "held_out"
            ]
          },
          "source_kind": {
            "const": "native"
          },
          "game_id": {
            "type": "string",
            "minLength": 1
          },
          "origin_family_id": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          },
          "native_manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "pitch_calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "sample": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "offset",
              "length",
              "sha256",
              "encoding"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "encoding": {
                "enum": [
                  "BRR",
                  "PSX_ADPCM"
                ]
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_grid",
        "margin_grid",
        "max_false_accept_rate",
        "min_reviewed_development_cases",
        "min_reviewed_development_families"
      ],
      "properties": {
        "distance_grid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "margin_grid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "max_false_accept_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_reviewed_development_cases": {
          "type": "integer",
          "minimum": 1
        },
        "min_reviewed_development_families": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lineage_links": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "instrument-origin-splits-v1.schema.json#/$defs/lineageLink"
      }
    },
    "metadata": {
      "type": "object"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
