{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CBongo/game-music-extraction/schemas/instrument-candidate-reviews-v1.schema.json",
  "title": "Instrument candidate reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_sha256",
    "reviewer_id",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "instrument-candidate-reviews/v1"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_record_id",
          "package_id",
          "revealed",
          "candidate_assessments"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "revealed": {
            "type": "boolean"
          },
          "candidate_assessments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "decision",
                "audition_acknowledged",
                "source_audio_sha256",
                "candidate_audio_sha256"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision": {
                  "enum": [
                    "acceptable",
                    "unacceptable"
                  ]
                },
                "audition_acknowledged": {
                  "const": true
                },
                "source_audio_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "candidate_audio_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "metadata": {
                  "type": "object"
                }
              }
            }
          },
          "correction_requested": {
            "type": "boolean"
          },
          "octave_correction": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          },
          "chord_offsets_correction": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "integer",
              "minimum": -127,
              "maximum": 127
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
