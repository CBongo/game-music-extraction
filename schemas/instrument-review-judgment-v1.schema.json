{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CBongo/game-music-extraction/schemas/instrument-review-judgment-v1.schema.json",
  "title": "Human judgment for an immutable isolated instrument review package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "source_record_id",
    "reviewer_id",
    "decision",
    "candidate_id",
    "revealed"
  ],
  "properties": {
    "schema_version": {
      "const": "instrument-review-judgment/v1"
    },
    "package_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "alternate_candidate",
        "no_match",
        "ambiguous"
      ]
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "revealed": {
      "type": "boolean"
    },
    "octave_correction": {
      "type": "integer",
      "minimum": -4,
      "maximum": 4,
      "default": 0
    },
    "chord_offsets_correction": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": -48,
        "maximum": 48
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
