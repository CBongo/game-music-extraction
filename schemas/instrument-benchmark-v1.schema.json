{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CBongo/game-music-extraction/schemas/instrument-benchmark-v1.schema.json",
  "title": "Instrument benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "license",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "instrument-benchmark/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "record_id",
          "split",
          "source",
          "labels",
          "label_basis",
          "provenance",
          "render_conditions",
          "asset"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "historical-dev",
              "synthetic-contract",
              "same-bank-sanity",
              "unlabeled-review",
              "heldout-game",
              "heldout-platform"
            ]
          },
          "source": {
            "type": "object"
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "instrument-analysis-v1.schema.json#/$defs/route"
                }
              },
              "gm_families": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                }
              },
              "observed_pitch_offset_semitones": {
                "type": "number"
              },
              "component_offsets": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "abstain": {
                "type": "boolean"
              },
              "candidate_audition_octave_adjustment": {
                "type": "integer"
              }
            }
          },
          "label_basis": {
            "enum": [
              "historical_curated",
              "generated_exact",
              "render_recipe_identity",
              "unlabeled",
              "blinded_review"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "render_conditions": {
            "type": "object",
            "required": [
              "note",
              "velocity",
              "duration_seconds",
              "tail_seconds",
              "sample_rate",
              "effects"
            ],
            "properties": {
              "note": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "velocity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 127
              },
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "tail_seconds": {
                "type": "number",
                "minimum": 0
              },
              "sample_rate": {
                "type": "integer",
                "minimum": 8000
              },
              "effects": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "asset": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "local_game_source",
                  "generated_fixture",
                  "gm_reference_recipe"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
