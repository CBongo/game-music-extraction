{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CBongo/game-music-extraction/schemas/instrument-query-pitch-calibration-v1.schema.json",
  "title": "Hash-bound acoustic pitch calibration for a neutral WAV query",
  "description": "Acoustic F0 measurement bound to an ordinary query WAV, exact event-window boundaries, and caller-assigned neutral record ID; contains no renderer or raw chip fields.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "basis", "status", "source_record_id", "wav_path", "wav_sha256", "event_boundaries_seconds", "sounding_midi_note", "f0_hz", "confidence", "evidence", "method", "window_estimates", "median_absolute_deviation_cents"],
  "properties": {
    "schema_version": { "const": "instrument-query-pitch-calibration/v1" },
    "basis": { "const": "acoustic_measurement" },
    "status": { "enum": ["calibrated", "abstain"] },
    "source_record_id": { "type": "string", "minLength": 1 },
    "wav_path": { "type": "string", "minLength": 1 },
    "wav_sha256": { "$ref": "#/$defs/sha256" },
    "event_boundaries_seconds": {
      "type": "object", "additionalProperties": false, "required": ["note_on", "note_off", "end"],
      "properties": { "note_on": { "type": "number", "minimum": 0 }, "note_off": { "type": "number", "exclusiveMinimum": 0 }, "end": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "sounding_midi_note": { "type": ["number", "null"], "minimum": 0, "maximum": 127 },
    "f0_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "window_estimates": { "type": "array", "items": { "$ref": "#/$defs/windowEstimate" } },
    "median_absolute_deviation_cents": { "type": ["number", "null"], "minimum": 0 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "calibrated" } }, "required": ["status"] }, "then": { "properties": { "sounding_midi_note": { "type": "number", "minimum": 0, "maximum": 127 }, "f0_hz": { "type": "number", "exclusiveMinimum": 0 }, "confidence": { "type": "number", "minimum": 0.8, "maximum": 1 }, "median_absolute_deviation_cents": { "type": "number", "minimum": 0 }, "window_estimates": { "contains": { "type": "object", "properties": { "f0_hz": { "type": "number", "exclusiveMinimum": 0 } }, "required": ["f0_hz"] }, "minContains": 2 } } } },
    { "if": { "properties": { "status": { "const": "abstain" } }, "required": ["status"] }, "then": { "properties": { "sounding_midi_note": { "type": "null" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "windowEstimate": {
      "type": "object", "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "f0_hz", "confidence", "periodicity", "ambiguity", "envelope_modulation"],
      "properties": {
        "start_seconds": { "type": "number", "minimum": 0 }, "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "f0_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "periodicity": { "type": "number", "minimum": 0, "maximum": 1 }, "ambiguity": { "type": "number", "minimum": 0, "maximum": 1 },
        "envelope_modulation": { "type": "number", "minimum": 0 }
      }
    }
  }
}
