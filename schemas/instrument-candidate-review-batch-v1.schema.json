{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CBongo/game-music-extraction/schemas/instrument-candidate-review-batch-v1.schema.json",
  "title": "Instrument candidate review batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "corpus_ref",
    "artifacts",
    "cases",
    "manifest_id"
  ],
  "properties": {
    "schema_version": {
      "const": "instrument-candidate-review-batch/v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "corpus_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_record_id",
          "package_id",
          "folder"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "folder": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
